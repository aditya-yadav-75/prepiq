# PrepIQ Server Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.

# Server Port (Render sets this automatically to 10000; local default is 5001)
PORT=5001

# Application Environment (development | production)
NODE_ENV=production

# Mandatory JWT Secret Key: Must be at least 32 characters long.
# The server will fail safely at startup if this variable is missing or too weak.
JWT_SECRET=prepiq_production_jwt_hmac_sha256_secret_key_minimum_32_characters_2026

# Optional: Google Gemini API Key for live AI exam generation.
# If omitted, PrepIQ operates seamlessly in high-fidelity local semantic generation mode.
GEMINI_API_KEY=

# Google Gemini Model Name
GEMINI_MODEL=gemini-1.5-flash

# Configurable CORS Origin Allowlist (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://prepiq-upc7.onrender.com

# Configurable Data Directory for Persistence (e.g., Render Persistent Disk mount path)
# Defaults to server/data if unset
DATA_DIR=
